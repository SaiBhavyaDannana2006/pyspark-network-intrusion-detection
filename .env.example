# ==============================================================================
# SentinelSpark Environment Configuration
# Copy this file to .env to override default parameters
# ==============================================================================

# Spark Engine Configuration
SPARK_APP_NAME="SentinelSpark-Network-Intrusion-Intelligence"
SPARK_MASTER="local[*]"
SPARK_DRIVER_MEMORY="4g"
SPARK_EXECUTOR_MEMORY="4g"
SPARK_LOG_LEVEL="WARN"

# Storage & Paths
DATA_RAW_DIR="data/raw"
DATA_PROCESSED_DIR="data/processed"
MODELS_DIR="models"
RESULTS_DIR="results"

# Execution mode
ENVIRONMENT="development"
